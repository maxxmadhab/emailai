# Server Configuration
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Supabase Postgres Database (Direct or Session Pooler connection)
DATABASE_URL=postgresql://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase API & Auth
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-at-least-32-chars

# AES-256-GCM Encryption Key (64 hex characters = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Redis Configuration (Docker or Cloud)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch Configuration
ELASTICSEARCH_NODE=http://localhost:9200

# Worker Settings
WORKER_CONCURRENCY=5

# Slack OAuth (Phase 3)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# Admin Emails (C2) - Comma-separated list of emails bootstrapped as admin
ADMIN_EMAILS=admin@reachinbox.ai,oliver.brown@domain.io

# Frontend URL for OAuth redirects (C3)
FRONTEND_URL=http://localhost:5173

