{
  "name": "reachinbox-backend",
  "version": "1.0.0",
  "description": "Express + TypeScript API and worker for ReachInbox email scheduler",
  "private": true,
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "test": "vitest run --pool=forks --poolOptions.forks.singleFork",
    "test:watch": "vitest",
    "test:all": "vitest run --pool=forks --poolOptions.forks.singleFork",
    "e2e:phase1": "vitest run tests/e2e/phase1.e2e.test.ts",
    "e2e:phase2": "vitest run tests/e2e/phase2.e2e.test.ts",
    "e2e:phase3": "vitest run tests/e2e/phase3.e2e.test.ts",
    "load:1000": "tsx scripts/simulate-load-1000.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "ethereal:create": "tsx scripts/create-ethereal-account.ts"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.4",
    "@bull-board/express": "^9.10.4",
    "@elastic/elasticsearch": "^8.12.2",
    "@prisma/client": "^5.10.2",
    "@supabase/supabase-js": "^2.117.3",
    "bullmq": "^5.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^6.9.12",
    "pino": "^8.19.0",
    "pino-http": "^9.0.0",
    "pino-pretty": "^10.3.1",
    "sanitize-html": "^2.18.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.11.24",
    "@types/nodemailer": "^6.4.14",
    "@types/pino-http": "^5.8.4",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.10.2",
    "supertest": "^6.3.4",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
